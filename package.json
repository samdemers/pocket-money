{
  "name": "tink-banking-app",
  "version": "1.0.0",
  "description": "Banking application with Tink API integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm start",
    "dev:all": "concurrently \"npm run dev\" \"npm run client\"",
    "dev:mobile": "concurrently \"npm run dev\" \"cd client && HOST=0.0.0.0 npm start\"",
    "network-info": "node get-network-info.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:client": "cd client && npm test -- --watchAll=false",
    "test:all": "npm test && npm run test:client",
    "test:comprehensive": "node test-runner.js"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^8.2.0",
    "jest": "^30.0.5",
    "mongodb-memory-server-core": "^10.1.4",
    "nodemon": "^3.0.1",
    "nodemon-webpack-plugin": "^4.8.2",
    "playwright": "^1.54.2",
    "supertest": "^7.1.4"
  },
  "keywords": [
    "banking",
    "tink",
    "fintech",
    "transactions"
  ],
  "author": "",
  "license": "MIT"
}
